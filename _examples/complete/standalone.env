# Runs the complete example without Docker: the database and OpenTelemetry are off and the /db/notes
# routes are not registered (the cache is in memory anyway):
# go run ./_examples/complete -config _examples/complete/config.yaml -envfile _examples/complete/standalone.env
DATABASE_ENABLED=false
LOGGING_OUTPUT_OTEL_ENABLED=false
TRACING_OTEL_ENABLED=false
